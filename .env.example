APP_NAME=Online Knowledge API
API_V1_PREFIX=/api/v1
DEBUG=true

KNOWLEDGE_STORE_DIR=data/knowledge
KNOWLEDGE_CHUNK_SIZE=512
KNOWLEDGE_CHUNK_OVERLAP=64
KNOWLEDGE_TOP_K=5

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

RERANK_MODEL=data/models/bge-reranker-base
RERANK_TOP_N=50

# EMBEDDING_MODEL 可填 HuggingFace 模型名或本地模型目录。
# 首次下载模型需要能访问 HuggingFace，网络不通时先设置 HF_ENDPOINT=https://hf-mirror.com

# ===== app_es（Elasticsearch 后端）以下为新增配置，app 会忽略这些键 =====
KNOWLEDGE_LIST_LIMIT=500
# ES_EMBEDDING_DIM 必须与 embedding 模型维度一致
ES_URL=http://localhost:9200
# ES_USERNAME=
# ES_PASSWORD=
# ES_API_KEY=
# ES_VERIFY_CERTS=true
# ES_CA_CERTS=
ES_REQUEST_TIMEOUT=10
ES_INDEX_DOCUMENTS=knowledge_documents
ES_INDEX_CHUNKS=knowledge_chunks
ES_ANALYZER=standard
ES_NUMBER_OF_SHARDS=1
ES_NUMBER_OF_REPLICAS=0
ES_EMBEDDING_DIM=512
